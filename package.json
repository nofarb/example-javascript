{
  "name": "example-javascript",
  "version": "1.0.0",
  "scripts": {
    "test": "jest --coverage",
    "build": "vite build"
  },
  "devDependencies": {
    "jest": "^28.0.0"
  },
  "dependencies": {
    "vite": "^2.9.0"
  },
  "jest": {
    "collectCoverage": true,  // Enable coverage collection
    "coverageDirectory": "coverage", // Directory to store the coverage reports
    "coverageReporters": ["lcov", "json", "text", "html"],  // Report formats to generate
    "coveragePathIgnorePatterns": ["/node_modules/", "/tests/"] // Optionally ignore directories
  }
}
